{
  "name": "portos-client",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5554",
    "build": "node ../scripts/publish-client-build.js",
    "build:analyze": "node ../scripts/publish-client-build.js --analyze",
    "lint": "biome lint --error-on-warnings src",
    "preview": "vite preview",
    "test": "vitest run",
    "test:ci": "vitest run --bail=1 --silent=passed-only --reporter=default --reporter=github-actions",
    "test:ci:related": "vitest related --run --bail=1 --silent=passed-only --reporter=default --reporter=github-actions",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.42.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.1",
    "recharts": "3.10.1",
    "socket.io-client": "4.8.3",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@vitejs/plugin-react": "6.1.1",
    "happy-dom": "20.14.0",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  },
  "overrides": {
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3",
    "nanoid": "3.3.18",
    "three": "0.185.1",
    "postcss": "8.5.27"
  }
}
