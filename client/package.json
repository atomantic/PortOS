    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.33.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "recharts": "3.10.1",
    "socket.io-client": "4.8.3",
    "three": "0.185.1",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
