    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@vitejs/plugin-react": "6.1.0",
    "jsdom": "30.0.1",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "socket.io-parser": "4.2.7",
    "ws": "8.21.3",
    "nanoid": "3.3.18",
    "minimatch@3": {
      "brace-expansion": "1.1.18"
