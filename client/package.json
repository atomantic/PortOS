{
  "name": "portos-client",
  "version": "1.7.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "vite --configLoader runner --host 0.0.0.0 --port 5554",
    "build": "node ../scripts/publish-client-build.js",
    "build:analyze": "node ../scripts/publish-client-build.js --analyze",
    "lint": "biome lint --error-on-warnings src",
    "preview": "vite preview --configLoader runner",
    "test": "vitest run --configLoader runner",
    "test:ci": "node ../scripts/run-vitest-ci.js run --silent=passed-only --reporter=default --reporter=github-actions --configLoader runner",
    "test:watch": "vitest --configLoader runner"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1",
    "recharts": "3.10.1",
    "socket.io-client": "4.8.4",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "happy-dom": "21.0.4",
    "playwright-core": "1.64.1",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "overrides": {
    "socket.io-parser": "4.2.7",
    "ws": "8.22.0",
    "nanoid": "3.3.18",
    "three": "0.186.1",
    "postcss": "8.5.28"
  }
}
