  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=12.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5554",
    "build": "vite build",
    "build:analyze": "ANALYZE=true vite build",
