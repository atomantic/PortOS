#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

run_client=false
run_server=false

while IFS= read -r file; do
  [ -z "$file" ] && continue
  case "$file" in
    client/*)
      run_client=true
      ;;
    server/*)
      run_server=true
      ;;
    package.json|package-lock.json)
      run_client=true
      run_server=true
      ;;
  esac
done <<< "$STAGED"

if [ "$run_server" = false ] && [ "$run_client" = false ]; then
  exit 0
fi

printf -- "\n🔎 pre-commit: validating staged PortOS changes\n"

if [ "$run_server" = true ]; then
  printf -- "- running server tests...\n"
  # NODE_ENV=test is what points the suite at the file storage backend instead
  # of the developer's live Postgres. server/vitest.config.js now forces it, but
  # a commit fired from a PortOS-spawned shell inherits NODE_ENV=development
  # from PM2, so state it here too — the hook must be correct on its own (#4554).
  NODE_ENV=test npm test --prefix server
fi

if [ "$run_client" = true ]; then
  printf -- "- running client lint...\n"
  npm run lint --prefix client
  printf -- "- running client build...\n"
  npm run build --prefix client
fi

printf -- "✅ pre-commit checks passed\n"
