#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Lightweight local policy: lint, structural guards and directly owned tests.
# Hosted CI owns broad coverage; no transitive server/browser/DB/build suite.
#
# Do not build the client here: that would publish this branch's build into
# the dist the running install serves (#12045). Validation never swaps it.
printf -- "\n🔎 pre-commit: running focused local pregate on the PortOS changes\n"
node scripts/pregate.js

printf -- "✅ pre-commit checks passed\n"
