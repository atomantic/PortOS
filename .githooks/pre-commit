#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# Lightweight local policy: lint, structural guards and directly owned tests.
# Hosted CI owns broad coverage; no transitive server/browser/DB/build suite. The hook deliberately runs nothing
# else: it used to run the whole server suite and `npm run build --prefix
# client`, which publishes the branch's build into the dist the running
# install serves (#12045). Validation never swaps what `npm start` serves.
printf -- "\n🔎 pre-commit: running focused local pregate on the PortOS changes\n"
node scripts/pregate.js

printf -- "✅ pre-commit checks passed\n"
