#!/usr/bin/env bash
set -euo pipefail

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT"

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -z "$STAGED" ]; then
  exit 0
fi

# The same planner and runners CI uses (scripts/pregate.js), bounded to the
# changed files and the always-run guards. The hook deliberately runs nothing
# else: it used to run the whole server suite and `npm run build --prefix
# client`, which publishes the branch's build into the dist the running
# install serves (#12045). Validation never swaps what `npm start` serves.
printf -- "\n🔎 pre-commit: running pregate on the staged PortOS changes\n"
node scripts/pregate.js

printf -- "✅ pre-commit checks passed\n"
