{
  "name": "portos-server",
  "version": "1.7.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=11.11.0"
  },
  "scripts": {
    "dev": "node --watch start.js",
    "start": "node start.js",
    "lint": "biome lint --error-on-warnings --max-diagnostics=20 .",
    "test": "vitest run --configLoader runner",
    "test:fast": "vitest run --configLoader runner",
    "test:watch": "vitest --configLoader runner",
    "test:ci": "node ../scripts/run-vitest-ci.js run --silent=passed-only --reporter=default --reporter=github-actions --configLoader runner",
    "test:coverage": "vitest run --coverage --configLoader runner",
    "setup:db:test": "node scripts/setup-db-test.mjs",
    "test:db": "vitest run --config vitest.config.db.js --configLoader runner",
    "test:db:ci": "node ../scripts/run-vitest-ci.js run --config vitest.config.db.js --reporter=default --reporter=github-actions --configLoader runner"
  },
  "dependencies": {
    "@babel/parser": "8.1.2",
    "@cantoo/pdf-lib": "2.11.1",
    "@googleapis/calendar": "20.2.0",
    "@novnc/novnc": "1.7.0",
    "better-sqlite3-multiple-ciphers": "13.0.3",
    "chokidar": "6.0.0",
    "compression": "1.8.2",
    "express": "5.3.0",
    "node-pty": "1.2.0-beta.18",
    "pg": "8.23.1",
    "playwright-core": "1.65.0",
    "pm2": "7.1.2",
    "sharp": "0.35.5",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "three": "0.187.0",
    "undici": "8.12.4",
    "ws": "8.23.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "10.14.0",
    "vitest": "5.1.0"
  },
  "overrides": {
    "path-to-regexp": "8.4.2",
    "lodash": "4.18.1",
    "follow-redirects": "1.16.3",
    "body-parser": "2.4.0",
    "js-yaml": "4.3.2",
    "engine.io": "6.6.11",
    "qs": "6.17.1",
    "sharp": "0.35.5",
    "socket.io-parser": "4.2.7",
    "ws": "8.23.0",
    "postcss": "8.5.32",
    "nanoid": "3.3.20",
    "minimatch": "11.0.8"
  }
}
