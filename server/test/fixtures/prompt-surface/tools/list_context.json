{
  "name": "list_context",
  "description": "List a bounded page from one enabled read-only context scope.",
  "schema": {
    "type": "object",
    "properties": {
      "scope": {
        "type": "string",
        "enum": [
          "navigation",
          "workspaces",
          "brain",
          "identity"
        ]
      },
      "cursor": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      },
      "limit": {
        "type": "integer",
        "minimum": 1,
        "maximum": 25
      }
    },
    "required": [
      "scope"
    ],
    "additionalProperties": false
  },
  "annotations": {
    "readOnlyHint": true,
    "destructiveHint": false,
    "idempotentHint": true,
    "openWorldHint": false
  }
}
