{
  "name": "eidoverse.draft-foundation",
  "description": "Compose a chosen layout plus a material and motif (from eidoverse.creative-catalog) into an eidoverse.record-ready `district-template` input — the generative placement in `body`, the material/motif cosmetics in `style`. This only drafts — it never records anything; pass the returned `foundation` to eidoverse.record to persist it.",
  "schema": {
    "type": "object",
    "properties": {
      "id": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "summary": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      },
      "disclosure": {
        "default": {},
        "type": "object",
        "properties": {
          "requires": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "effects": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            }
          },
          "license": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "default": null,
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 600
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "requires",
          "effects",
          "license",
          "notes"
        ],
        "additionalProperties": false
      },
      "layoutId": {
        "type": "string",
        "enum": [
          "radial-ring",
          "grid-plot",
          "arc-row",
          "grove-cluster"
        ]
      },
      "materialId": {
        "type": "string",
        "enum": [
          "sunbaked-clay",
          "weathered-copper",
          "moonlit-slate",
          "coral-lacquer",
          "moss-stone",
          "brushed-steel"
        ]
      },
      "motifId": {
        "type": "string",
        "enum": [
          "lantern-row",
          "garden-grove",
          "colonnade",
          "market-stalls",
          "tide-pools"
        ]
      },
      "anchor": {
        "minItems": 3,
        "maxItems": 3,
        "type": "array",
        "items": {
          "type": "number"
        }
      },
      "propCount": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      },
      "seed": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      },
      "facing": {
        "type": "number"
      }
    },
    "required": [
      "id",
      "title",
      "summary",
      "disclosure",
      "layoutId",
      "materialId",
      "motifId",
      "anchor"
    ],
    "additionalProperties": false
  },
  "sideEffect": "read"
}
