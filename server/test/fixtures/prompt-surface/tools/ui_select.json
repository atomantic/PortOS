{
  "name": "ui_select",
  "description": "Pick an option from a <select> dropdown by label. \"Set status to Active\" → label=\"Status\", option=\"Active\".",
  "schema": {
    "type": "object",
    "properties": {
      "label": {
        "type": "string",
