{
  "name": "health.log.nicotine",
  "description": "Log nicotine use (cigarette, vape puff, pouch) to MortalLoom / Meatspace tracking. ",
  "schema": {
    "type": "object",
    "properties": {
      "product": {
        "type": "string",
        "description": "Product type (e.g. \"cigarette\", \"vape\", \"Zyn pouch\", \"cigar\")."
      },
      "count": {
        "type": "number",
        "description": "How many units (default 1)."
      },
      "mgPerUnit": {
        "type": "number",
        "description": "Nicotine milligrams per unit. Omit to use category default."
      }
    },
    "required": [
      "product"
    ],
    "additionalProperties": false
  },
  "sideEffect": "write"
}
