{
  "fixtureVersion": 1,
  "family": "codex",
  "nativeContract": "codex app-server account/read + account/usage/read, shape verified against runtime 0.166.0. Synthetic values.",
  "scenarios": [
    {
      "name": "complete contiguous history is available but completeness stays unknown",
      "account": { "account": { "type": "chatgpt", "planType": "plus" } },
      "usage": {
        "summary": { "lifetimeTokens": 300, "peakDailyTokens": 200, "longestRunningTurnSec": 9, "currentStreakDays": 2, "longestStreakDays": 2 },
        "dailyUsageBuckets": [{ "startDate": "2026-02-01", "tokens": 100 }, { "startDate": "2026-02-02", "tokens": 200 }]
      },
      "expect": {
        "status": "available", "completeness": "unknown", "retention": "unknown",
        "scope": { "kind": "account", "accountKey": null, "identity": "unknown", "aggregation": "once-per-account" },
        "dateBoundary": { "kind": "provider-calendar-day", "timezone": null },
        "accountContext": { "status": "read", "authMethod": "chatgpt", "planType": "plus" },
        "freshness": { "earliestObserved": "2026-02-01", "latestObserved": "2026-02-02" },
        "missingIntervals": { "status": "reported", "intervals": [], "truncated": false },
        "totals": { "lifetimeTokens": 300, "dailyBuckets": [{ "startDate": "2026-02-01", "tokens": 100 }, { "startDate": "2026-02-02", "tokens": 200 }] },
        "cost": { "estimatedApiEquivalentUsd": null, "actualSpendUsd": null, "nativeCostSignal": null },
        "attribution": "excluded", "findings": []
      }
    },
    {
      "name": "null summary and null history stay unknown instead of zero",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": null, "peakDailyTokens": null, "longestRunningTurnSec": null, "currentStreakDays": null, "longestStreakDays": null },
        "dailyUsageBuckets": null
      },
      "expect": {
        "status": "partial",
        "totals": { "lifetimeTokens": null, "dailyBuckets": null },
        "missingIntervals": { "status": "unknown", "intervals": null, "truncated": null },
        "freshness": { "latestObserved": null },
        "findings": ["lifetime-unknown", "history-unknown"]
      }
    },
    {
      "name": "an empty returned history differs from null history",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": 0, "peakDailyTokens": 0, "longestRunningTurnSec": 0, "currentStreakDays": 0, "longestStreakDays": 0 },
        "dailyUsageBuckets": []
      },
      "expect": {
        "status": "available",
        "totals": { "lifetimeTokens": 0, "dailyBuckets": [] },
        "missingIntervals": { "status": "reported", "intervals": [] },
        "findings": []
      }
    },
    {
      "name": "an absent history field fails closed because the normalizer rejects the payload",
      "account": { "account": { "type": "chatgpt" } },
      "usage": { "summary": { "lifetimeTokens": 5, "peakDailyTokens": 5, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 } },
      "expect": { "status": "unavailable", "totals": null, "findings": ["refresh-failed"] }
    },
    {
      "name": "calendar gaps are reported and never filled with zero buckets",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": 30, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-02-01", "tokens": 10 }, { "startDate": "2026-02-05", "tokens": 20 }]
      },
      "expect": {
        "status": "available",
        "missingIntervals": { "status": "reported", "intervals": [{ "from": "2026-02-02", "to": "2026-02-04" }], "truncated": false },
        "totals": { "dailyBuckets": [{ "startDate": "2026-02-01", "tokens": 10 }, { "startDate": "2026-02-05", "tokens": 20 }] },
        "findings": ["calendar-gaps"]
      }
    },
    {
      "name": "daily buckets exceeding lifetime are inconsistent, the only direction provable",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": 10, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-02-01", "tokens": 20 }]
      },
      "expect": { "status": "partial", "findings": ["daily-exceeds-lifetime"] }
    },
    {
      "name": "a bucket dated past every timezone is flagged without assuming a bucket timezone",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": 20, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-03-20", "tokens": 20 }]
      },
      "expect": { "status": "partial", "dateBoundary": { "timezone": null }, "findings": ["future-dated-bucket"] }
    },
    {
      "name": "tomorrow's bucket is allowed because an eastern provider day can already have started",
      "account": { "account": { "type": "chatgpt" } },
      "usage": {
        "summary": { "lifetimeTokens": 20, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-03-02", "tokens": 20 }]
      },
      "expect": { "status": "available", "findings": [] }
    },
    {
      "name": "a sign-in change during the capture discards the snapshot",
      "account": { "account": { "type": "chatgpt", "planType": "plus" } },
      "accountAfter": { "account": { "type": "chatgpt", "planType": "team" } },
      "usage": {
        "summary": { "lifetimeTokens": 20, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-02-01", "tokens": 20 }]
      },
      "expect": { "status": "unavailable", "totals": null, "accountContext": { "status": "changed" }, "findings": ["account-changed-during-capture"] }
    },
    {
      "name": "a refresh failure is unavailable, not zero usage",
      "account": { "account": { "type": "chatgpt" } },
      "usageFailureCode": "CODEX_APP_SERVER_TIMEOUT",
      "expect": { "status": "unavailable", "totals": null, "accountContext": { "status": "read" }, "findings": ["refresh-failed"] }
    },
    {
      "name": "a usage read that succeeds while the account read fails keeps its data but is partial",
      "accountFailed": true,
      "usage": {
        "summary": { "lifetimeTokens": 20, "peakDailyTokens": 20, "longestRunningTurnSec": 1, "currentStreakDays": 1, "longestStreakDays": 1 },
        "dailyUsageBuckets": [{ "startDate": "2026-02-01", "tokens": 20 }]
      },
      "expect": { "status": "partial", "accountContext": { "status": "unread" }, "totals": { "lifetimeTokens": 20 }, "findings": ["account-context-unread"] }
    },
    {
      "name": "a signed-out participant has no account source",
      "account": { "account": null },
      "usageFailureCode": "CODEX_APP_SERVER_PROTOCOL_ERROR",
      "expect": { "status": "absent", "totals": null, "accountContext": { "status": "signed-out" }, "findings": ["signed-out"] }
    },
    {
      "name": "a participant without the runtime has no account source",
      "accountFailed": true,
      "usageFailureCode": "CODEX_RUNTIME_MISSING",
      "expect": { "status": "absent", "totals": null, "accountContext": null, "findings": ["runtime-missing"] }
    }
  ]
}
