          { "timestamp": 1772323200, "params": { "sessionId": "s1", "update": { "sessionUpdate": "turn_completed", "prompt_id": "p1", "usage": { "inputTokens": 10, "outputTokens": 1 } } } },
          { "timestamp": 1772323200, "params": { "sessionId": "s1", "update": { "sessionUpdate": "turn_completed", "prompt_id": "p1", "usage": { "inputTokens": 10, "outputTokens": 1 } } } }
