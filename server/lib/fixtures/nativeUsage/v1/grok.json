          { "timestamp": 1772323260, "params": { "sessionId": "s1", "update": { "sessionUpdate": "turn_completed", "prompt_id": "p2", "usage": { "inputTokens": 20, "outputTokens": 2, "totalTokens": 22, "cachedReadTokens": 5, "costUsdTicks": 200, "modelUsage": { "model-a": { "inputTokens": 20 } } } } } },
          { "timestamp": 1772323320, "params": { "sessionId": "s1", "update": { "sessionUpdate": "turn_completed", "prompt_id": "p3", "usage": { "inputTokens": 30, "outputTokens": 3, "totalTokens": 33, "cachedReadTokens": 5, "costUsdTicks": 300, "modelUsage": { "model-a": { "inputTokens": 30 } } } } } }
        ]
      },
      "expect": {
